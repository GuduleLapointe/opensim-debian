<?xml version="1.0"?>
<ruleset name="opensim-kit PHP compatibility">
    <description>The PHP versions the code supports. The range comes from composer.json, given by tests/Environment/PhpCompatibilityTest.php.</description>

    <rule ref="PHPCompatibility">
    </rule>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/contrib/*</exclude-pattern>
    <exclude-pattern>*/upstream/*</exclude-pattern>
    <exclude-pattern>*/core/*</exclude-pattern>
    <exclude-pattern>*/dev/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <arg name="extensions" value="php"/>
</ruleset>
