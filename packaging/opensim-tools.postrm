#!/bin/sh
# postrm of opensim-tools: on purge, forgets the service and the owner of the
# folders, and removes the cache. Config, data, logs and the opensim account
# are kept.
set -e

if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi

if command -v deb-systemd-helper >/dev/null; then
    case "$1" in
        remove)
            deb-systemd-helper mask opensim.service >/dev/null || true
            ;;
        purge)
            deb-systemd-helper purge opensim.service >/dev/null || true
            deb-systemd-helper unmask opensim.service >/dev/null || true
            ;;
    esac
fi

if [ "$1" = "purge" ]; then
    rm -rf /var/cache/opensim
    # The owner set by postinst, the folders themselves being kept by dpkg
    # while not empty
    for dir in /etc/opensim /etc/opensim/grids /etc/opensim/opensim.d /etc/opensim/robust.d \
        /var/lib/opensim /var/lib/opensim/data /var/log/opensim /var/cache/opensim; do
        if dpkg-statoverride --list "$dir" >/dev/null; then
            dpkg-statoverride --remove "$dir"
        fi
    done
fi
