gloebit 0.9.3.0 88 1 contrib/Gloebit/Gloebit.ini.example
gloebit unstable 88 1 https://github.com/gloebit/opensim-moneymodule-gloebit/releases/download/build-88/Gloebit--0.9.3.1Dev--linux--2026-06-07--de5bc63.dll bdb23dbeca3c62718b4392386e5d65c575872380fdbc59200be3bdbcd2739913 Gloebit.dll
