#!/bin/sh
# The helpers read the helpers.ini of each grid: readable by the web server only, when the machine has one
# (its group is the web server's). The setup does the same for the grids it writes.
set -e

if [ "$1" = configure ] && getent group www-data >/dev/null 2>&1; then
    # The setup, run as the user of the instances, gives the helpers.ini it writes to that group
    if getent passwd opensim >/dev/null 2>&1; then
        adduser --quiet opensim www-data || true
    fi
    for ini in /etc/opensim/grids/*/helpers.ini; do
        [ -f "$ini" ] || continue
        chgrp www-data "$ini"
        chmod 0640 "$ini"
    done
fi

#DEBHELPER#
exit 0
