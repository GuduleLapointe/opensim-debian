#!/bin/sh
# postinst of the opensim-<version> packages: tells how to install the .NET
# runtime when it is missing. opensim-tools, when installed, adds the install
# profile of the release.
set -e

version=${DPKG_MAINTSCRIPT_PACKAGE#opensim-}
core=/usr/share/opensim/$version

if [ "$1" = "configure" ]; then
    # apt runs maintainer scripts without /usr/local/bin, where
    # opensim install-dotnet links the runtime
    PATH=$PATH:/usr/local/bin
    required=$(grep -o '"version": *"[0-9]*' "$core/bin/OpenSim.runtimeconfig.json" | grep -o '[0-9]*$' || true)
    required=${required:-8}
    if ! dotnet --list-runtimes 2>/dev/null |
        awk -v m="$required" '$1 == "Microsoft.NETCore.App" && $2 + 0 >= m { found = 1 } END { exit !found }'; then
        echo "opensim-$version: OpenSim needs the .NET $required runtime (or newer)." >&2
        if command -v opensim >/dev/null; then
            echo "  Install it with: sudo opensim install-dotnet $required" >&2
        else
            echo "  See https://learn.microsoft.com/dotnet/core/install/linux" >&2
        fi
    fi
fi
