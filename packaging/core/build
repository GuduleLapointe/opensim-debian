#!/usr/bin/env bash
# Builds the packages of an OpenSimulator distribution into dist/:
#   opensim-<version>  the distribution in /usr/share/opensim/<version>, for
#                      amd64 and arm64, the architectures of its native libraries
#   opensim            the metapackage installing the kit and the latest
#                      version, built with the latest version of SHA256SUMS
#
# Usage, from the repository root:
#   packaging/core/build <version> [revision]
#
# The revision (default 1) numbers the builds of the same upstream version:
# a published package is never changed, a fix gets the next revision.
# The upstream tarball is downloaded into src/ (the installer's sources
# folder) and checked against SHA256SUMS, which lists the supported versions.
# Publish with apt-publish (apt-repo), e.g.:
#   /opt/apt-repo/bin/apt-publish dist/opensim-0.9.3.0_0.9.3.0-1_*.deb dist/opensim_0.9.3.0-1_all.deb

set -e

URL=http://opensimulator.org/dist
CORE_DIR=packaging/core

OPENSIM_VERSION=${1:?usage: packaging/core/build <version> [revision]}
PACKAGE_REVISION=${2:-1}

cd "$(git rev-parse --show-toplevel)"

tarball=opensim-$OPENSIM_VERSION.tar.gz
checksum=$(awk -v f="$tarball" '$2 == f {print $1}' "$CORE_DIR/SHA256SUMS")
[[ -n "$checksum" ]] || {
    echo "$tarball is not in $CORE_DIR/SHA256SUMS" >&2
    exit 1
}

mkdir -p src dist
if [[ ! -f "src/$tarball" ]]; then
    curl -fSL "$URL/$tarball" -o "src/$tarball.part"
    mv "src/$tarball.part" "src/$tarball"
fi
(cd src && echo "$checksum  $tarball" | shasum -a 256 -c -)

# The distribution, read-only for everyone but root, whatever the local umask
BUILD=build/opensim-$OPENSIM_VERSION
rm -rf "$BUILD"
mkdir -p "$BUILD"
tar -xzf "src/$tarball" --strip-components=1 -C "$BUILD"
# On start, OpenSim puts the Linux System.Drawing.Common.dll in place when
# the one there differs: done here, as the installed core is read-only
if [[ -f "$BUILD/bin/System.Drawing.Common.dll.linux" ]]; then
    cp "$BUILD/bin/System.Drawing.Common.dll.linux" "$BUILD/bin/System.Drawing.Common.dll"
fi
chmod -R u+rwX,go+rX,go-w "$BUILD"
sed "s/@VERSION@/$OPENSIM_VERSION/g" "$CORE_DIR/copyright" >"build/copyright-$OPENSIM_VERSION"

# nfpm expands variables in some fields only: the definitions get their
# values here
package() {
    local config=build/$(basename "$1")
    sed -e "s|\${OPENSIM_VERSION}|$OPENSIM_VERSION|g" -e "s|\${PACKAGE_REVISION}|$PACKAGE_REVISION|g" \
        -e "s|\${ARCH}|${ARCH:-all}|g" -e "s|\${BUILD}|$BUILD|g" "$1" >"$config"
    nfpm package --config "$config" --packager deb --target dist/
}

for ARCH in amd64 arm64; do
    package "$CORE_DIR/opensim-core.yaml"
done
unset ARCH

latest=$(awk '{print $2}' "$CORE_DIR/SHA256SUMS" | sed -E 's/^opensim-(.*)\.tar\.gz$/\1/' | sort -V | tail -1)
if [[ "$OPENSIM_VERSION" == "$latest" ]]; then
    package "$CORE_DIR/opensim.yaml"
fi
