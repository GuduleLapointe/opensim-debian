#!/bin/sh
# postrm of the opensim-<version> packages: on purge, removes the install
# profile of this core. When it was the default, the kit falls back to the
# latest core installed.
set -e

version=${DPKG_MAINTSCRIPT_PACKAGE#opensim-}
core=/usr/share/opensim/$version
conf=/etc/opensim/opensim.conf
profile=opensim-$version

if [ "$1" = "purge" ] && [ -f "$conf" ] && command -v crudini >/dev/null; then
    if [ "$(crudini --get "$conf" "$profile" CoreDirectory 2>/dev/null)" = "$core" ]; then
        crudini --inplace --del "$conf" "$profile"
        if [ "$(crudini --get "$conf" Defaults DefaultProfile 2>/dev/null)" = "$profile" ]; then
            for key in DefaultProfile OpensimVersion CoreDirectory Runtime; do
                crudini --inplace --del "$conf" Defaults "$key"
            done
        fi
    fi
fi
