#!/bin/sh
# The settings hold the password of the database: readable by the web server
# only, when the machine has one (its group is the web server's)
set -e

if [ "$1" = configure ]; then
    conf=/etc/opensim/helpers/search/databaseinfo.php
    if getent group www-data >/dev/null 2>&1; then
        chown root:www-data "$conf"
        chmod 0640 "$conf"
    fi
fi

#DEBHELPER#
exit 0
