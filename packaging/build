#!/usr/bin/env bash
# Prepares the files of the packages to build, given by name (default: all).
# Run by apt-package from the repository root.
#
# opensim-tools: build/opensim-tools, the tools as committed (HEAD) with their
#   bash-helpers submodule, without what they do not distribute
#   (packaging/distignore), with their PHP dependencies. The working copy is
#   left untouched.
# opensim-core, opensim: the OpenSimulator release of
#   packaging/opensim-core.versions, the last one or OPENSIM_VERSION; for
#   opensim-core, build/opensim-core from its tarball, downloaded into src/
#   and checked against its SHA256.
#
# The variables of the definitions go to build/packaging.env.

set -e

URL=http://opensimulator.org/dist

packages=" ${*:-opensim-tools opensim-core opensim opensim-kit} "
wants() {
    local name
    for name in "$@"; do
        [[ "$packages" == *" $name "* ]] && return 0
    done
    return 1
}

mkdir -p build
: >build/packaging.env

if wants opensim-tools; then
    BUILD=build/opensim-tools
    rm -rf "$BUILD"
    mkdir -p "$BUILD"
    git archive HEAD | tar -x -C "$BUILD"

    # Submodules the tools need at run time, at their committed version
    for submodule in libexec/bash-helpers; do
        commit=$(git ls-tree HEAD "$submodule" | awk '{print $3}')
        mkdir -p "$BUILD/$submodule"
        git -C "$submodule" archive "$commit" | tar -x -C "$BUILD/$submodule"
    done

    while read -r entry; do
        [[ -z "$entry" || "$entry" == \#* ]] || rm -rf "${BUILD:?}/${entry%/}"
    done <packaging/distignore

    composer install --no-dev --no-interaction --quiet --optimize-autoloader --working-dir="$BUILD"

    # Installed read-only for everyone but root, whatever the local umask
    chmod -R go-w "$BUILD"
fi

if wants opensim-core opensim; then
    read -r version revision checksum < <(
        awk -v v="${OPENSIM_VERSION:-}" '!/^#/ && NF && (v == "" || $1 == v)' packaging/opensim-core.versions | tail -1
    ) || true
    if [[ -z "$version" ]]; then
        echo "OpenSimulator $OPENSIM_VERSION is not in packaging/opensim-core.versions" >&2
        exit 1
    fi
    # The native libraries of the distribution are for amd64 and arm64
    cat >>build/packaging.env <<EOF
OPENSIM_VERSION=$version
OPENSIM_REVISION=$revision
ARCHITECTURES="amd64 arm64"
EOF
fi

if wants opensim-core; then
    tarball=opensim-$version.tar.gz
    mkdir -p src
    if [[ ! -f "src/$tarball" ]]; then
        curl -fSL "$URL/$tarball" -o "src/$tarball.part"
        mv "src/$tarball.part" "src/$tarball"
    fi
    (cd src && echo "$checksum  $tarball" | shasum -a 256 -c -)

    BUILD=build/opensim-core
    rm -rf "$BUILD"
    mkdir -p "$BUILD"
    tar -xzf "src/$tarball" --strip-components=1 -C "$BUILD"
    # On start, OpenSim puts the Linux System.Drawing.Common.dll in place when
    # the one there differs: done here, as the installed core is read-only
    if [[ -f "$BUILD/bin/System.Drawing.Common.dll.linux" ]]; then
        cp "$BUILD/bin/System.Drawing.Common.dll.linux" "$BUILD/bin/System.Drawing.Common.dll"
    fi
    chmod -R u+rwX,go+rX,go-w "$BUILD"
    sed "s/@VERSION@/$version/g" packaging/opensim-core.copyright >build/opensim-core.copyright
fi
