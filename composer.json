{
  "name": "gudulelapointe/opensim-kit",
  "description": "OpenSim deployment and management tools for Debian-based systems",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "Gudule Lapointe",
      "email": "gudule@speculoos.world",
      "homepage": "https://speculoos.world"
    },
    {
      "name": "Olivier van Helden",
      "homepage": "https://magiiic.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "laravel/prompts": "^0.3.18",
    "magicoli/opensim-engine": "dev-dev",
    "magicoli/opensim-helpers": "dev-dev",
    "magicoli/opensim-rest-php": "dev-dev"
  },
  "require-dev": {
    "deployer/deployer": "^7.3",
    "magicoli/bash-tools": "^1.0.4"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../opensim-helpers",
      "canonical": false,
      "options": {
        "symlink": true,
        "versions": {
          "magicoli/opensim-helpers": "dev-dev"
        }
      }
    },
    {
      "type": "path",
      "url": "../opensim-engine",
      "canonical": false,
      "options": {
        "symlink": true,
        "versions": {
          "magicoli/opensim-engine": "dev-dev"
        }
      }
    },
    {
      "type": "path",
      "url": "../opensim-rest-php",
      "canonical": false,
      "options": {
        "symlink": true,
        "versions": {
          "magicoli/opensim-rest-php": "dev-dev"
        }
      }
    }
  ],
  "minimum-stability": "dev",
  "config": {
    "allow-plugins": {},
    "platform": {
      "php": "8.1.0"
    }
  },
  "autoload": {
    "psr-4": {
      "OpenSim\\Installer\\": "install/src/"
    }
  },
  "prefer-stable": true
}
