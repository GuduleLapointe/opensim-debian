{
  "name": "gudulelapointe/opensim-kit",
  "description": "OpenSim deployment and management tools for Debian-based systems",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "Gudule Lapointe",
      "email": "gudule@speculoos.world",
      "homepage": "https://speculoos.world"
    },
    {
      "name": "Olivier van Helden",
      "homepage": "https://magiiic.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-ctype": "*",
    "ext-gettext": "*",
    "ext-iconv": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "laravel/prompts": "^0.3.18",
    "magicoli/opensim-engine": "dev-dev",
    "magicoli/opensim-helpers": "dev-dev",
    "magicoli/opensim-rest-php": "dev-dev"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "deployer/deployer": "^7.3",
    "magicoli/bash-tools": "^1.0.4",
    "magicoli/pest-failure-summary": "^1.0",
    "pestphp/pest": "^3.0",
    "phpcompatibility/php-compatibility": "dev-develop",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../opensim-helpers",
      "canonical": false,
      "options": {
        "symlink": true,
        "versions": {
          "magicoli/opensim-helpers": "dev-dev"
        }
      }
    },
    {
      "type": "path",
      "url": "../opensim-engine",
      "canonical": false,
      "options": {
        "symlink": true,
        "versions": {
          "magicoli/opensim-engine": "dev-dev"
        }
      }
    },
    {
      "type": "path",
      "url": "../opensim-rest-php",
      "canonical": false,
      "options": {
        "symlink": true,
        "versions": {
          "magicoli/opensim-rest-php": "dev-dev"
        }
      }
    }
  ],
  "minimum-stability": "dev",
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "pestphp/pest-plugin": true
    },
    "platform": {
      "php": "8.2.0"
    }
  },
  "autoload": {
    "psr-4": {
      "OpenSim\\Installer\\": "install/src/"
    },
    "files": [
      "install/engine.php"
    ]
  },
  "prefer-stable": true,
  "suggest": {
    "ext-intl": "better transliteration of the grid names",
    "ext-posix": "detect the user the setup runs as"
  },
  "scripts": {
    "test": "pest"
  }
}
