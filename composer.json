{
  "name": "gudulelapointe/opensim-kit",
  "description": "OpenSim deployment and management tools for Debian-based systems",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "Gudule Lapointe",
      "email": "gudule@speculoos.world",
      "homepage": "https://speculoos.world"
    },
    {
      "name": "Olivier van Helden",
      "homepage": "https://magiiic.com"
    }
  ],
  "require-dev": {
    "deployer/deployer": "^7.3",
    "magicoli/bash-tools": "dev-dev"
  },
  "config": {
    "allow-plugins": {},
    "platform": {
      "php": "8.1.0"
    }
  },
  "require": {
    "php": ">=8.1",
    "laravel/prompts": "^0.3.18"
  },
  "autoload": {
    "psr-4": {
      "OpenSim\\Installer\\": "install/src/"
    }
  },
  "repositories": [{
    "name": "bash-tools",
    "type": "path",
    "url": "../{bash-tools}",
    "canonical": false,
    "options": {
      "symlink": true,
      "versions": {
        "magicoli/bash-tools": "dev-dev"
      }
    }
  }]
}
