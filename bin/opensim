#!/usr/bin/env bash

# Copyright 2015 Olivier van Helden <olivier@van-helden.net>
# Released under GNU Affero GPL v3.0 license
#    http://www.gnu.org/licenses/agpl-3.0.html

# Run from the real location when called through a link (e.g. /usr/bin/opensim):
# the helpers find the rest of the kit from the script path.
[ -L "$0" ] && exec "$(readlink -f "$0")" "$@"

DELAY=60
shutdownDelay=120
shutdownWarnings=3
DEBUG=${DEBUG:-}

BASEDIR=$(cd $(dirname "$0")/.. && pwd)

# Run as the caller, root for the whole system
if [ "${1:-}" = "install-dotnet" ]; then
	shift
	exec "$BASEDIR/libexec/install-dotnet" "$@"
fi

. $BASEDIR/libexec/os-helpers || exit 1
trap 'rm -f $TMP*' EXIT

# Instances belong to the system user of the install, when set (e.g. opensim
# for the packages): switch to it whoever runs the command, screen sessions
# being per user.
if [ -n "$SystemUser" ] && [ "$(id -un)" != "$SystemUser" ]; then
	rm -f $TMP*
	if [ "$(id -u)" = 0 ]; then
		exec runuser -u "$SystemUser" -- "$0" "$@"
	fi
	exec sudo -H -u "$SystemUser" "$0" "$@"
fi

# The setup wizard, as the system user too: the files of the grids belong to it
if [ "${1:-}" = "setup" ]; then
	exec php "$BASEDIR/install/install.php"
fi

source $BASEDIR/libexec/venv-setup || end $? "Could not setup python venv"

require crudini

log "DirectoryLayout: $DirectoryLayout"
log "Profile: ${DefaultProfile:-} (OpenSim $OpensimVersion)"
log "CoreRoot: $CoreRoot"
log "CoreDirectory: $CoreDirectory"
log "BinDirectory: $BinDirectory"
log "OpenSimExe: $OpenSimExe"
log "EtcRoot: $EtcRoot"
log "VarRoot: $VarRoot"
log "DataRoot: $DataRoot"
log "CacheRoot: $CacheRoot"
log "LogsRoot: $LogsRoot"

[ -z "$EtcRoot" ] && end 1 "Etc directory not set"


HELP="
$PGM <start|stop [now]|restart [now]> [instance1] [instance2] [...]
$PGM status
$PGM setup           create or modify grids (setup wizard)
$PGM install-dotnet  install the .NET runtime OpenSim needs (as root)

	-h display this help
	-v verbose mode
	-q quiet mode"

OPTS="shvq"
while getopts $OPTS PARAM; do
	case $PARAM in
	"?")
		ERROR=1
		;;
	-)
		case $OPTARG in
		help)
			help
			end
			;;
		*)
			printf "$PGM: illegal option -- $OPTARG"
			#    ERROR=1
			;;
		esac
		;;
	s)
		action=start
		;;
	h)
		help
		end
		;;
	v)
		STDERR="&1"
		DEBUG=yes
		QUIET=no
		;;
	q)
		STDOUT="/dev/null"
		QUIET=yes
		DEBUG=no
		;;
	*)
		VALUES="$VALUES $PARAM"
		LASTVAL=$PARAM
		;;
	esac

done 2>/dev/null
shift $(expr $OPTIND - 1)

#ini_parser="$(which ini_parser)"
#[ -n "$ini_parser" ] || end 1 no ini parser
#log "ini_parser: $ini_parser"
# . "$(which ini_parser)" || end 2 could not launch ini parser

startSim() {
	# Only starting needs a core: stop and status work without one
	[ -z "$OpenSimExe" ] && end 2 "could not find OpenSim.exe"
	ProfileBinDirectory=$BinDirectory
	unset IFS
	for arg in $@; do
		unset ConsoleUser ConsolePass ConsolePort console_port LogsDirectory EtcDirectory \
			BinDirectory BinDir LogConfig logconfig LogFile
		ls -d "$arg" 2>/dev/null | grep -q "\.ini$" &&
			{
				inifile=$arg
				instance=$(basename $arg .ini | tr "[:upper:]" "[:lower:]")
			} ||
			{
				instance=$(echo $arg | tr "[:upper:]" "[:lower:]")
				inifile=$(buildIni "$instance")
			}

		[ ! -e "$inifile" ] && continue

		instance=$(echo "$instance" | sed "s/[^a-zA-Z0-9_]*//g")

		log "$instance ($ini)"

		# Drop leftover dead sessions so they are not mistaken for a running one.
		screen -wipe >/dev/null 2>&1
		if osScreenExists "$instance"; then
			log "$instance is already running"
			continue
		fi

		log 1 "starting $instance"

		# for default in $(echo "$ETCPATH:" | sed "s|/*:|/default.ini |g")
		# do
		#     [ -f "$default" ] || continue
		#     ini_parser "$default" || continue
		#     ini_section_Const 2>/dev/null
		#     ini_section_Startup 2>/dev/null
		#     ini_section_Launch 2>/dev/null
		# done
		log extracting launch info from $inifile file

		# cat "$inifile" | sed '/\[Const]/,/^\[/!d' | sed "$ d" > $TMP.ini
		# cat "$inifile" | sed '/\[Launch]/,/^\[/!d' | sed "$ d" >> $TMP.ini
		# cat "$inifile" | sed '/\[Startup]/,/^\[/!d' | sed "$ d" >> $TMP.ini
		# log reading $inifile file
		# ini_parser "$TMP.ini" || continue
		# # ini_parser "$inifile" || continue
		# #2>/dev/null || continue
		# log reading section Launch
		crudget $inifile Const 2>/dev/null || end $? "error reading launch section"
		crudget $inifile Launch 2>/dev/null || end $? "error $? reading section Launch"
		crudget $inifile Startup 2>/dev/null || end $? "error $? reading section Launch"

		crudget $inifile Network 2>/dev/null || end $? "error $? reading section Launch"
		[ "$ConsolePort" = "0" ] && ConsolePort=""
		[ "$console_port" = "0" ] && console_port=""

		# Core: BinDirectory of the instance config (BinDir, deprecated), else
		# the core chosen for its grid (<nick>.conf of the grid folder, where
		# the enabled config links to), else the one of the install profile
		BinDirectory=${BinDirectory:-$BinDir}
		if [ -z "$BinDirectory" ]; then
			griddir=$(dirname "$(readlink -f "$inifile")")
			gridconf="$griddir/$(basename "$griddir").conf"
			[ -f "$gridconf" ] && GridCore=$(crudget "$gridconf" Grid CoreDirectory) || GridCore=
			BinDirectory=${GridCore:+$GridCore/bin}
		fi
		BinDirectory=${BinDirectory:-$ProfileBinDirectory}

		[ -z "$BinDirectory" ] && end 1 "Could not find a valid BinDirectory"
		log "BinDirectory: $BinDirectory"

		Executable=${executable:-${Executable}}
		# Assembly base name: from a [Launch] Executable if provided, otherwise
		# from the instance type (robust.d -> Robust, opensim.d -> OpenSim; other
		# types like MoneyServer/pCampBot will map here later).
		if [ -n "$Executable" ]; then
			ExecName=$(basename "$Executable")
			ExecName=${ExecName%.exe}
			ExecName=${ExecName%.dll}
		else
			case "$inifile" in
			*robust.d/* | *robust*) ExecName=Robust ;;
			*) ExecName=OpenSim ;;
			esac
		fi

		# Single source of truth (os-helpers) for the exe/dll + runtime decision.
		osResolveRuntime "$ExecName" "$BinDirectory"
		log "Executable $Executable ($runtime), OpenSim version ${osversion:-unknown}"

		log "starting $instance with $inifile"

		cd $BinDirectory 2>/dev/null || end 2 $instance Cannot cd to $BinDirectory
		log "BinDirectory $BinDirectory"
		[ -f $Executable ] || end 3 Executable $Executable not found

		# Fail early with a clear message if the runtime is missing, rather
		# than letting the instance crash on launch.
		checkRuntimeAvailable "$runtime" "$Executable" || continue

		Include_Common=$(crudget $inifile Includes Include-Common 2>/dev/null)
		# crudini --get $inifile Includes Include-Common
		CommonLogsRoot=$(crudget $Include_Common Const LogsRoot | sed -e "s#\${Launch|SimName}#$instance#g" -e "s#\${Launch|MachineName}#$instance#g")
		# Logs: LogsDirectory of the instance ([Const], from the grid wizard),
		# else LogsRoot of its common include, else the install's
		InstanceLogsRoot=${LogsDirectory:-${CommonLogsRoot:-$LogsRoot}}

		LogFile=${LogFile:-$InstanceLogsRoot/$instance.log}
		log "LogsRoot $InstanceLogsRoot"

		# Log config: from the instance config, else the one the grid wizard
		# writes next to it, else one made from the core's model
		LogConfig=${logconfig:-${LogConfig}}
		[ -z "$LogConfig" ] && [ -f "$EtcDirectory/$ExecName.exe.config" ] &&
			LogConfig="$EtcDirectory/$ExecName.exe.config"
		DataRoot=${datadirectory:-${DataRoot}}
		[ ! "$LogConfig" ] && LogConfig="$DataRoot/$(basename "$inifile" .ini).LogConfig"
		log "LogConfig $LogConfig"
		log Executable $Executable
		if [ ! -f "$LogConfig" ]; then
			sed -e "s|[a-zA-Z0-9\./_-]*/*$ExecName.log|$InstanceLogsRoot/$instance.log|" \
				-e "s|[a-zA-Z0-9\./_-]*/*${ExecName}Stats.log|$InstanceLogsRoot/${instance}.Stats.log|" \
				$BinDirectory/$ExecName.exe.config >$TMP.logconfig &&
				mv $TMP.logconfig "$LogConfig" &&
				log created LogConfig file $LogConfig from core model $BinDirectory/$ExecName.exe.config ||
				end $?
			# cd /opt/opensim/var/data/config
			# ln -s $LogConfig 2>/dev/null
		fi
		# The log file is the one of the log config
		if [ -f "$LogConfig" ]; then
			ConfigLogFile=$(egrep "LogFileAppender|<file" $LogConfig | grep -A1 "LogFileAppender" | head -2 | tail -1 | cut -d '"' -f 2)
			LogFile=${ConfigLogFile:-$LogFile}
			touch "$LogFile" && log "LogFile $LogFile touched"
		fi

		ConsolePrompt=${consoleprompt:-${ConsolePrompt}}

		cmd="$runtime${runtime_opts:+ $runtime_opts} $Executable -inifile='$inifile'"
		if [ "${Executable%.*}" = "Robust" ]; then
			[ ! "$ConsolePrompt" ] && ConsolePrompt="Robust ($instance) "
			cmd="$cmd -logfile='$LogFile' -prompt '$ConsolePrompt'"
		else
			[ ! "$ConsolePrompt" ] && ConsolePrompt="$instance (\R) "
		fi
		[ -f "$LogConfig" ] && cmd="$cmd -logconfig='$LogConfig'"

		ConsoleUser=${ConsoleUser:-${consoleuser}}
		ConsolePass=${ConsolePass:-${consolepass}}
		[ "${Executable%.*}" = "Robust" ] &&
			ConsolePort=${ConsolePort:-${consoleport}} ||
			ConsolePort=${console_port:-${consoleport}}

		if [ "$ConsoleUser" ] && [ "$ConsolePass" ] && [ "$ConsolePort" ]; then
			RestEnabled=true
			log "RestEnabled: $RestEnabled"
			# log "console_port: $console_port"
			cmd="$cmd -console rest"
		else
			RestEnabled=false
		fi

		# touch $TMP.wait
		log "Working directory: $PWD"
		log "launching $instance "
		log "$cmd"

		if [ "$RestEnabled" = "true" ]; then
			nohup $cmd >$TMP.$instance.nohup 2>&1 &
			timeout 60 tail -Fn0 $TMP.$instance.nohup 2>/dev/null | egrep -am 1 "Error|UserAgentServerConnector loaded successfully|RegionReady|neighbours.*region.*is up|loaded successfully|LOAD REGIONS PLUGIN]: Done|\[CONSOLE\] Quitting"
		else
			# Capture the session output so an early crash can be reported.
			startlog="$TMP.$instance.startup.log"
			eval "screen -L -Logfile '$startlog' -S $instance -d -m $cmd"
			screen -S $instance -X logfile flush 1 2>/dev/null

			# Confirm the session actually came up. An immediate exit (e.g. a
			# missing or incompatible runtime) would otherwise leave us polling
			# a dead session and spamming "No screen session found".
			sleep 1
			if ! osScreenExists "$instance"; then
				log 1 "$instance failed to start: the process exited immediately"
				[ -s "$startlog" ] && cat "$startlog" >&2
				log "Reproduce the command with: $PGM -v start $instance"
				continue
			fi

			if [ "${Executable%.*}" = "Robust" ]; then
				osConsoleWait $instance "UserAgentServerConnector loaded successfully"
			else
				osConsoleWait 5 $instance "RegionUUID" && osConsole $instance "\n"
				osConsoleWait 1 $instance "Internal IP address" && osConsole $instance "\n"
				osConsoleWait 1 $instance "External host name" && osConsole $instance "\n"
				osConsoleWait 1 $instance "Do you wish to join region .* to an existing estate" && osConsole $instance "\n" &&
					osConsoleWait 1 $instance "Name of estate to join." && osConsole $instance "\n"

				osConsoleWait 120 $instance "RegionReady|neighbours.*region.*is up|loaded successfully|LOAD REGIONS PLUGIN]: Done"
			fi

			# Interpret the final wait result the same way for both server types.
			case $? in
			0) log "$instance started" ;;
			3)
				log 1 "$instance exited while starting"
				[ -s "$startlog" ] && tail -n 20 "$startlog" >&2
				log "Reproduce the command with: $PGM -v start $instance"
				;;
			*) log "$instance still starting, let it run and check status later" ;;
			esac
		fi

	done
}

stopSim() {
	[ "$1" ] && sims=$@ || sims=$(enabledIni opensim robust)
	for sim in $sims; do
		simName=$(ini2Name $sim)
		ls -d "$sim" 2>/dev/null | grep -q "\.ini$" &&
			{
				inifile=$sim
				instance=$(basename $sim .ini | tr "[:upper:]" "[:lower:]")
			} ||
			{
				instance=$(echo $sim | tr "[:upper:]" "[:lower:]")
				inifile=$(buildIni "$sim")
			}

		# cat "$inifile" | sed '/\[Const]/,/^\[/!d' | sed "$ d" > $TMP.ini
		# cat "$inifile" | sed '/\[Launch]/,/^\[/!d' | sed "$ d" >> $TMP.ini
		# cat "$inifile" | sed '/\[Startup]/,/^\[/!d' | sed "$ d" >> $TMP.ini
		# ini_parser "$TMP.ini" || continue
		# ini_section_Const 2>/dev/null
		# ini_section_Launch 2>/dev/null
		crudget $inifile Const || crudget $inifile const
		crudget $inifile Launch || crudget $inifile launch
		crudget $inifile Network 2>/dev/null
		ConsoleUser=${ConsoleUser:-${consoleuser}}
		ConsolePass=${ConsolePass:-${consolepass}}
		[ "${Executable%.*}" = "Robust" ] &&
			ConsolePort=${ConsolePort:-${consoleport}} ||
			ConsolePort=${console_port:-${consoleport}}
		[ "$ConsolePort" = "0" ] && ConsolePort=""
		if [ "$ConsoleUser" ] && [ "$ConsolePass" ] && [ "$ConsolePort" ]; then
			export OSIM_REST_INI="$inifile"
		else
			unset OSIM_REST_INI
		fi

		if [ "${Executable%.*}" = "OpenSim" ]; then
			log notiy users in $simName
			[ $shutdownDelay = 0 ] && warnDelay=0 || warnDelay=$(($shutdownDelay / $shutdownWarnings))
			warn=0
			[ $shutdownDelay -le 10 ] && shutdownWarnings=1
			[ $shutdownDelay -eq 0 ] && shutdownWarnings=0
			while [ $warn -lt $shutdownWarnings ]; do
				remaining=$(($shutdownDelay - $warn * $warnDelay))
				log " $remaining seconds left"
				osConsole $simName "alert Attention: this simulator will be stopped in $remaining seconds. Please teleport to another region to avoid being disconnected."
				sleep $warnDelay
				warn=$(($warn + 1))
			done
			osConsole $simName "alert Shutting down now."
		fi
		log shutting down $simName
		pid=$(ps -C mono -C dotnet --no-headers -o pid,args 2>/dev/null |
			grep " -inifile=" | grep -F "$inifile" | awk '{print $1}' | head -1)
		osConsole $simName shutdown
		timeout=60
		screen -x $simName 2>/dev/null
		if [ "$pid" ]; then
			log "Waiting for $simName (pid $pid) to exit..."
			timeout $timeout tail --pid=$pid -f /dev/null 2>/dev/null
			kill -0 $pid 2>/dev/null && log "$simName still running after ${timeout}s"
		fi
	done
}

restartSim() {
	[ "$1" ] && sims="$@" || sims=$(enabledIni robust opensim)
	for sim in $sims; do
		simName=$(ini2Name $sim)
		echo restart $simName
		stopSim $simName
		startSim $simName
	done
}

ini2Name() {
	[ ! "$1" ] && return "no-name"
	ini=$1
	[ -f "$1" ] && name=$(egrep "^[[:blank:]]SimName *=" $ini)
	[ ! $name ] && name=$(basename $ini .ini | tr [:upper:] [:lower:])
	echo $name
}
enabledIni() {
	[ "$1" ] && types=$@ || types="robust opensim"
	for type in $types; do
		case $type in
		robust)
			ls "$etc"/robust.d/*.ini 2>/dev/null | sort -n
			ls "$etc"/robust-enabled/*.ini 2>/dev/null | sort -n
			;;
		opensim)
			ls "$etc"/opensim.d/*.ini 2>/dev/null | sort -n
			ls "$etc"/simulators-enabled/*.ini 2>/dev/null | sort -n
			;;
		esac
	done
}

buildIni() {
	unset ini
	sim="$@"
	ini=$(
		IFS=":"
		for etc in $ETCPATH; do
			log "looking in $etc"
			(
				ls "$etc"/*.d/*.ini 2>/dev/null
				ls "$etc"/*-enabled/*.ini 2>/dev/null
			) | grep -i "/$sim.ini$" && break
			#	lookup="$etc/simulators-enabled/$sim.ini"
			#	log "looking for $lookup"
			#	[ -f "$lookup" ] || continue
			#	log "gotcha $lookup"
			#	ini="$lookup"
			#	break
		done | head -1
	)

	if [ ! -n "$ini" ]; then
		log 1 "no ini file found for $sim"
		return
	fi
	log "$sim ini $ini"
	echo "$ini"
}

cleanpath() {
	IFS=:
	printf "" >$TMP.realpath
	for etc in $@; do
		real=$(abspath "$etc")
		[ ! -d "$real" ] && continue
		grep -q "^$real$" $TMP.realpath && continue
		echo "$real" >>$TMP.realpath
	done
	unset IFS

	newpath=$(cat $TMP.realpath | tr "\n" ":" | sed "s/:$//")
	rm "$TMP.realpath"
	echo $newpath
}

status() {
	# Get running process data
	{
		ps -C mono --no-headers -o pid,uname,pcpu,pmem,rss,args 2>/dev/null
		ps -C dotnet --no-headers -o pid,uname,pcpu,pmem,rss,args 2>/dev/null
	} |
		grep -v mcs\.exe |
		grep " -inifile=" |
		sed -E "s/(mono|dotnet).*-inifile=//;s/-log.*//" \
			>"$TMP.ps_raw"

	# Collect configured-but-not-running instances before the pipe (subshell issue)
	seen=""
	IFS=":"
	touch $TMP.list
	for etc in $ETCPATH; do
		unset IFS
		for inifile in \
			"$etc"/robust.d/*.ini \
			"$etc"/robust-enabled/*.ini \
			"$etc"/opensim.d/*.ini \
			"$etc"/simulators-enabled/*.ini; do
			[ -f "$inifile" ] || continue
			real=$(readlink "$inifile")
			echo ":$seen:" | grep -qF ":$real:" && continue
			seen="$seen:$real"
			instance=$(basename "$inifile" .ini | tr "[:upper:] " "[:lower:]_")
			info=$(grep "$inifile" $TMP.ps_raw)
			[ -z "$info" ] && status=down || status=up
			grep -qi robust <<<"$inifile" && type=robust || type=opensim
			echo "$instance $type ${info:-[down]}" >>$TMP.list
		done
		IFS=":"
	done
	unset IFS

	# Build tab-separated table and align with column
	{
		printf "INSTANCE\tTYPE\tPID\tUSER\t%%CPU\t%%MEM\tRSS\n"
		while read instance type pid user cpu mem rss _; do
			printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n" "$instance" "$type" "$pid" "$user" "$cpu" "$mem" "$rss"
		done <$TMP.list
	} | column -t -s $'\t'

	# Summary
	up=$(grep -cv "\[down\]" $TMP.list)
	down=$(grep -c "\[down\]" $TMP.list)
	stats=$(awk 'BEGIN{cpu=0;mem=0;rss=0} {cpu+=$3; mem+=$4; rss+=$5} END {
        printf "cpu %.1f%% - mem %.1f%% - rss %d", cpu, mem, rss
    }' $TMP.ps_raw)

	if [ -t 1 ]; then
		printf "\033[32m%s up\033[0m, \033[31m%s down\033[0m - %s\n" "$up" "$down" "$stats"
	else
		printf "%s up, %s down - %s\n" "$up" "$down" "$stats"
	fi
}

B="[[:blank:]]*"

getRobustPath() {
	IFS=:
	for etc in $ETCPATH; do
		unset IFS
		for ini in $(
			egrep -li "^[[:blank:]]*Executable[[:blank:]]*=[[:blank:]]*Robust.exe[[:blank:]]*$" "$etc"/*-enabled/*.ini 2>/dev/null | sort -n
			ls "$etc"/default.ini 2>/dev/null
		); do
			egrep "^${B}BinDir${B}=" "$ini"
		done
	done | head -1 | sed "s/^[[:blank:]]*BinDir[[:blank:]]*=[[:blank:]]*//"
	unset IFS
}

ETCPATH=$(cleanpath "$ETCPATH")

#getRobustPath
#end

log looking in $EtcRoot

IFS=":"
for etc in $EtcRoot $ETCPATH; do
	folder=$(abspath "$etc")
	[ "$folder" ] || continue
	echo ":$LOOKUP:" | grep -q ":$folder:" && log "ignoring duplicate $etc" && continue
	LOOKUP="$LOOKUP:$folder" && continue
done
unset IFS
LOOKUP="$(echo $LOOKUP | sed "s/^:*//")"

if [ ! -n "$LOOKUP" ]; then
	end 1 "No valid folder found in $ETCPATH"
fi
ETCPATH=$LOOKUP
log "ETCPATH: $ETCPATH"

case "$1" in
"help")
	help
	end ""
	;;
"start")
	action=$1
	shift
	;;
"stop")
	action=$1
	shift
	[ "$1" = "now" ] && shutdownDelay=0 && shift
	stopSim "$@"
	;;
"restart")
	action=$1
	shift
	[ "$1" = "now" ] && shutdownDelay=0 && shift
	restartSim "$@"
	;;
"status")
	action=$1
	shift
	;;
esac

case $action in
status)
	status
	;;
start)
	if [ -n "$1" ]; then
		startSim "$@"
	else
		log Starting all
		IFS=:
		for etc in $ETCPATH; do
			unset IFS
			for ini in $(
				ls "$etc"/robust.d/*.ini 2>/dev/null | sort -n
				ls "$etc"/robust-enabled/*.ini 2>/dev/null | sort -n
				ls "$etc"/opensim.d/*.ini 2>/dev/null | sort -n
				ls "$etc"/simulators-enabled/*.ini 2>/dev/null | sort -n
			); do
				[ -f "$TMP.wait" -a "$DELAY" ] && read -p "waiting $DELAY seconds between instances " -t $DELAY
				rm -f "$TMP.wait"
				startSim "$ini"
			done
		done
		unset IFS
	fi
	;;
connections)
	;;
esac
